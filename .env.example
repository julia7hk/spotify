SPOTIFY_CLIENT_ID=your_client_id_here
SPOTIFY_CLIENT_SECRET=your_client_secret_here
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/callback

# Free LLM for background tagging (M4) — https://console.groq.com
GROQ_API_KEY=your_groq_key_here

# --- Production only (leave unset for local dev; see ops/DEPLOY.md) ---
# SPOTIFY_REDIRECT_URI=https://music.julia7hk.com/callback   # override the dev value above
# FRONTEND_URL=https://music.julia7hk.com                    # where /callback + /logout redirect back to
# SECRET_KEY=<random 32+ char string>                        # Flask session signing (openssl rand -hex 32)
# SESSION_COOKIE_SECURE=true                                 # mark session cookie Secure (HTTPS)
# TRUST_PROXY=true                                           # trust X-Forwarded-* from the nginx/Cloudflare proxy
# FLASK_DEBUG=false                                          # never run the debug server on the internet
